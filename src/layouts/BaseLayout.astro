---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogUrl?: string;
  ogDescription?: string;
  keywords?: string;
  css?: string[];
  preloadImage?: string;
  showFooter?: boolean;
}

const {
  title,
  description = "Tiny Village Spirit works with organizations to build tiny home communities to shelter their unhoused neighbors.",
  ogTitle,
  ogUrl = "https://tinyvillagespirit.org",
  ogDescription,
  keywords = "Tiny Village Spirit, Tiny House Village, Tiny House, Tiny Home, Tiny House Village Construction, Tiny House Village Construction California, Tiny House Village Construction Bay Area, tiny homes, homeless shelter, tiny homes for homeless",
  css = [],
  preloadImage,
  showFooter = true,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content={keywords}>
    <meta name="url" content={ogUrl}>
    <meta name="theme-color" content="#04747C">

    <meta property="og:title" content={ogTitle || title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content="https://tinyvillagespirit.org/media/logo-transparent.png" />
    <meta property="og:description" content={ogDescription || description} />

    {preloadImage && <link rel="preload" href={preloadImage} as="image">}

    <link rel="shortcut icon" href="/media/favicon.ico" type="image/png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="/styling/topnav.css">
    <link rel="stylesheet" href="/styling/footer.css">
    {css.map(href => <link rel="stylesheet" href={href} />)}
    <title>{title}</title>
</head>
<body>
    <Nav />
    <slot />
    {showFooter && <Footer />}

    <!-- ===== Grand Opening Popup ===== -->
    <div id="dd-backdrop" style="
        display:none;
        position:fixed;inset:0;z-index:999;
        background:rgba(11,26,28,0.78);
        backdrop-filter:blur(4px);
        align-items:center;justify-content:center;
        padding:20px;
        overflow:hidden;
    ">
        <!-- Confetti canvas sits behind the card -->
        <canvas id="dd-confetti" style="position:absolute;inset:0;pointer-events:none;"></canvas>

        <!-- Close button -->
        <button id="dd-close" aria-label="Close" style="
            position:absolute;top:20px;right:20px;z-index:2;
            width:36px;height:36px;border-radius:50%;border:none;
            background:rgba(255,255,255,0.18);color:#fff;
            font-size:22px;line-height:1;cursor:pointer;
            display:flex;align-items:center;justify-content:center;
        ">×</button>

        <!-- Floating content: headline + flyer + button -->
        <div style="
            position:relative;z-index:1;
            display:flex;flex-direction:column;align-items:center;gap:22px;
            max-width:440px;width:100%;
            animation:ddPop .4s cubic-bezier(.2,.7,.2,1);
        ">
            <p style="
                margin:0;text-align:center;
                font-family:'Fraunces',serif;font-weight:600;
                font-size:clamp(40px,8vw,56px);line-height:1.05;letter-spacing:-0.02em;
                color:#ffcc02;
                text-shadow:0 2px 24px rgba(0,0,0,0.5);
            ">It's finally here!</p>

            <img src="/media/grand-opening.jpg" alt="Grand Opening — Richmond Tiny House Village" style="
                width:100%;display:block;
                border-radius:14px;
                box-shadow:0 24px 60px rgba(0,0,0,0.55);
            ">

            <a href="https://forms.gle/Vz4HfBiFMMWo2vXK7" target="_blank" rel="noopener" style="
                display:inline-flex;align-items:center;justify-content:center;
                background:#ffcc02;color:#1b2426;
                font-family:'Poppins',sans-serif;font-weight:700;font-size:15px;
                padding:14px 30px;border-radius:999px;text-decoration:none;
                box-shadow:0 8px 24px rgba(0,0,0,0.35);
                transition:opacity .2s;
            " onmouseover="this.style.opacity='.88'" onmouseout="this.style.opacity='1'">
                RSVP for the Grand Opening
            </a>
        </div>
    </div>
    <style>
        @keyframes ddPop {
            from { opacity:0; transform:translateY(22px) scale(0.96); }
            to   { opacity:1; transform:none; }
        }
    </style>
    <script is:inline>
    (function() {
        var KEY = 'dd_grand_opening_seen';
        if (localStorage.getItem(KEY)) return;

        var backdrop = document.getElementById('dd-backdrop');
        var close    = document.getElementById('dd-close');
        var canvas   = document.getElementById('dd-confetti');
        var raf;

        backdrop.style.display = 'flex';

        // --- confetti ---
        var ctx = canvas.getContext('2d');
        function resize() { canvas.width = backdrop.offsetWidth; canvas.height = backdrop.offsetHeight; }
        resize();
        var COLORS = ['#07b1bd','#e8407a','#ffcc02','#04747c','#f9a8d4'];
        var pieces = [];
        for (var i = 0; i < 55; i++) {
            pieces.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                w: Math.random() * 9 + 4,
                h: Math.random() * 4 + 2,
                color: COLORS[Math.floor(Math.random() * COLORS.length)],
                speed: Math.random() * 1.4 + 0.5,
                angle: Math.random() * Math.PI * 2,
                spin: (Math.random() - 0.5) * 0.12,
                drift: (Math.random() - 0.5) * 0.6,
                alpha: Math.random() * 0.5 + 0.35,
            });
        }
        function drawConfetti() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            pieces.forEach(function(p) {
                ctx.save();
                ctx.translate(p.x, p.y);
                ctx.rotate(p.angle);
                ctx.globalAlpha = p.alpha;
                ctx.fillStyle = p.color;
                ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
                ctx.restore();
                p.y += p.speed;
                p.x += p.drift;
                p.angle += p.spin;
                if (p.y > canvas.height + 10) { p.y = -10; p.x = Math.random() * canvas.width; }
            });
            raf = requestAnimationFrame(drawConfetti);
        }
        drawConfetti();

        function dismiss() {
            backdrop.style.display = 'none';
            cancelAnimationFrame(raf);
            localStorage.setItem(KEY, '1');
        }
        close.addEventListener('click', dismiss);
        backdrop.addEventListener('click', function(e) { if (e.target === backdrop) dismiss(); });
        document.addEventListener('keydown', function(e) { if (e.key === 'Escape') dismiss(); });
    })();
    </script>

    <script is:inline src="/scripting/topnav.js"></script>
    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-VYD6FRZSK4"></script>
    <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-VYD6FRZSK4');
    </script>
</body>
</html>
