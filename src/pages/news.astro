    href: 'https://omny.fm/shows/kcbsam-on-demand/an-empty-lot-transforms-into-tiny-village-for-home',
    cta: 'Listen to the report',
    media: {
      kind: 'image',
      src: '/media/news-logos/kcbs.jpeg',
      alt: 'KCBS logo',
    },
  },
  {
    type: 'Video feature',
    source: 'YouTube',
    title: 'Fences: The First Step To A Tiny Homes Village In Richmond, CA',
    description: 'A video update from the Richmond build site showing how the project began taking shape on the ground.',
    href: 'https://www.youtube.com/watch?v=cQT8_cIKtLw',
    cta: 'Watch the full video',
    media: {
      kind: 'youtube',
      src: 'https://www.youtube.com/embed/cQT8_cIKtLw',
      alt: 'YouTube video about the Richmond Tiny Village project',
    },
  },
];

const pressItems = [
  {
    source: 'Richmondside',
    type: 'Article',
    title: 'Richmond, CA Tiny House Village for Unhoused Youths',
    href: 'https://richmondside.org/2026/09/25/richmond-ca-tiny-house-village-unhoused-youths/',
    cta: 'Read the story',
    media: {
      kind: 'image',
      src: '/media/news-logos/richmondside.png',
      alt: 'Richmondside logo',
      logo: true,
    },
  },
  {
    source: 'Hoodline',
    type: 'Article',
    title: 'Richmond opens 12 tiny homes for homeless youth, nearly doubling county beds',
    href: 'https://hoodline.com/2026/09/richmond-opens-12-tiny-homes-for-homeless-youth-nearly-doubling-county-beds/',
    cta: 'Read the story',
    media: {
      kind: 'image',
      src: '/media/news-logos/hoodline.png',
      alt: 'Hoodline logo',
      logo: true,
    },
  },
  {
    source: 'The U.S. Sun',
    type: 'Article',
