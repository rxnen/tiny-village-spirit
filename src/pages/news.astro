  },
  {
    type: 'Article',
    source: 'SFist',
    title: 'East Bay Tiny House Village Provides Homes For 12 Unhoused Young Adults',
    description: 'SFist reports on the Richmond village opening and the years of volunteer work that brought it to life.',
    href: 'https://sfist.com/2026/09/30/east-bay-tiny-house-village-provides-homes-for-12-unhoused-young-adults/',
    cta: 'Read the story',
