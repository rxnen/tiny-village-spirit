      kind: 'image',
      src: '/media/news-logos/sfist.png',
      alt: 'SFist logo',
    },
  },
  {
    type: 'Article',
    source: 'Richmond Standard',
    title: 'Richmond Tiny House Village, Farm & Garden set to open its gates',
    description: 'The Richmond Standard previews the opening of the village and what it means for unsheltered youth in Contra Costa County.',
    href: 'https://richmondstandard.com/community/2026/08/19/richmond-tiny-house-village-farm-garden-set-to-open-its-gates/',
    cta: 'Read the story',
    media: {
      kind: 'image',
      src: '/media/news-logos/richmond-standard.png',
      alt: 'Richmond Standard logo',
    },
  },
  {
    type: 'Article',
    source: 'Bay Area News Group',
    title: 'Community celebrates Richmond Tiny Village grand opening',
    description: 'The Mercury News and East Bay Times cover the grand opening celebration and the community partnerships behind the village.',
    href: 'https://www.mercurynews.com/2026/09/30/community-celebrates-richmond-tiny-village-grand-opening/',
    cta: 'Read the story',
    media: {
      kind: 'image',
      src: '/media/news-logos/ebt.webp',
      alt: 'Bay Area News Group logo',
    },
  },
  {
    type: 'Audio report',
    source: 'KCBS',
    title: 'An empty lot transforms into tiny village for homeless youth in Richmond',
